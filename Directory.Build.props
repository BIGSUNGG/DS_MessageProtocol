<Project>
  <PropertyGroup>
    <!-- 테스트·벤치마크·Sandbox 등 기본은 패키지 생성 안 함. Source/ 에서 재정의. -->
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- EmitCompilerGeneratedFiles 덤프가 기본 글롭으로 컴파일되는 것을 방지
         (Compile Remove 는 기본 글롭 평가 이전이라 무효 → DefaultItemExcludes 사용) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/generated-out/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
