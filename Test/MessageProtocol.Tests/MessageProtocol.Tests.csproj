<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <!-- 생성 코드 감사용 디스크 출력 (obj/**/generated) -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 속성·계약 사용 컴파일 대상 -->
    <ProjectReference Include="..\..\Source\MessageProtocol.Core\MessageProtocol.Core.csproj" />
    <!-- 생성기 단위 테스트(GeneratorDriver)용 참조 — 별칭으로 Core 공용 타입과의 동명 충돌 방지 -->
    <ProjectReference Include="..\..\Source\MessageProtocol.CodeGenerator\MessageProtocol.CodeGenerator.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
      <Aliases>generator</Aliases>
    </ProjectReference>
    <!-- 생성 코드 실제 동작 검증용 분석기 참조 -->
    <ProjectReference Include="..\..\Source\MessageProtocol.CodeGenerator\MessageProtocol.CodeGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false">
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
    <!-- Unity/netstandard2.1 프로필에서 생성된 폴백 코드(CollectionsMarshal 없음)를 실행으로 검증하는 픽스처 어셈블리 -->
    <ProjectReference Include="..\MessageProtocol.NetStandardFixtures\MessageProtocol.NetStandardFixtures.csproj" />
  </ItemGroup>

</Project>
